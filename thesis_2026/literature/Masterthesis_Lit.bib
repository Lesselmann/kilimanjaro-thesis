	langid = {english},
	file = {Full Text PDF:C\:\\Users\\Lukas\\Zotero\\storage\\DRULDPDS\\Tan und Le - 2019 - EfficientNet Rethinking Model Scaling for Convolutional Neural Networks.pdf:application/pdf},
}

