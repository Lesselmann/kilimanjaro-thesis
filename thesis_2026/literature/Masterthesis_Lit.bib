	urldate = {2026-04-13},
	date = {2024-02-02},
	eprinttype = {arxiv},
	eprint = {2304.07193 [cs]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition},
	file = {Full Text PDF:C\:\\Users\\Lukas\\Zotero\\storage\\BJRV999C\\Oquab et al. - 2024 - DINOv2 Learning Robust Visual Features without Supervision.pdf:application/pdf;Snapshot:C\:\\Users\\Lukas\\Zotero\\storage\\MMQSHPUM\\2304.html:text/html},
}

@inproceedings{scheibenreif_self-supervised_2022,
	location = {New Orleans, {LA}, {USA}},
	title = {Self-supervised Vision Transformers for Land-cover Segmentation and Classification},
